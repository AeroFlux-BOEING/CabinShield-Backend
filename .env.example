# ---- server ----
CS_ENV=dev
# Required when deployed. Tablet/console send X-API-Key; WebSocket uses ?token=
CS_API_KEY=
# Optional separate key for forecast ingest, aircraft feed and demo scenarios (defaults to CS_API_KEY)
CS_OPS_API_KEY=
# e.g. https://cabinshield.vercel.app (comma separated)
CS_CORS_ORIGINS=*
CS_DATA_DIR=./data

# ---- safety kernel (mirrors the tablet; demo defaults, not standards) ----
CS_SAFETY_BUFFER_S=10
CS_UPLINK_INTERVAL_S=900

# ---- flight simulator (demo aircraft feed) ----
CS_SIM_TICK_S=1.0
# sim seconds per real second (10 / 60 / 300 like the app)
CS_SIM_SPEED=60
CS_SIM_SLOW_NEAR_S=1560
CS_SIM_SLOW_SPEED=10

# ---- insight text (rule | llm) ----
CS_PLANNER=rule
CS_ANTHROPIC_API_KEY=
# a model ID available in your Anthropic console
CS_ANTHROPIC_MODEL=

# ---- live aviation weather: NWS Aviation Weather Center (aviationweather.gov, no key) ----
# live | fixture (saved responses in tests/fixtures/awc) | off
CS_WX_MODE=live
CS_WX_ROUTES=ICN-SFO
CS_WX_INTERVAL_S=600
CS_WX_PIREP_AGE_H=6
CS_WX_CORRIDOR_NM=120
CS_WX_PIREP_HAZARDS=true
CS_WX_KEEP_SEED=true
# replay: live areas appear "now" in simulator time · real: true UTC validity (always real for AIRCRAFT_FEED flights)
CS_WX_TIME_MODE=replay
# contact info appended to the User-Agent (AWC asks for a custom UA), e.g. team mail
CS_WX_CONTACT=
