# ---- 서버 ----
CS_ENV=dev
# 배포 시 반드시 설정 (태블릿/콘솔은 X-API-Key 헤더, WS는 ?token=)
CS_API_KEY=
# 배포 시 예: https://cabinshield.vercel.app (콤마 구분)
CS_CORS_ORIGINS=*

# ---- Safety Kernel (설명용 기본값, 표준값 아님) ----
CS_SAFETY_BUFFER_S=10
CS_TTA_QUANTILE_LOW=0.10
CS_CST_QUANTILE_HIGH=0.90
CS_MC_SAMPLES=2000
CS_CSM_GREEN_S=15

# ---- 시뮬레이터 ----
CS_SIM_TICK_S=1.0
# 리허설 시 3.0 등 배속
CS_SIM_SPEED=1.0
CS_SIM_LOOKAHEAD_S=120

# ---- 생성형 AI Planner (rule | llm) ----
CS_PLANNER=rule
CS_ANTHROPIC_API_KEY=
# Anthropic 콘솔에서 사용 가능한 모델 ID
CS_ANTHROPIC_MODEL=
